# Copy to backend/.env for local development. Never commit the real .env.

APP_ENV=development
DEBUG=true

# Host/port for local uvicorn runs (see README for the run command).
HOST=0.0.0.0
PORT=8000

# Comma-separated list of origins allowed to call the API (the Vite dev server).
CORS_ORIGINS=http://localhost:5173

# Where uploaded/cleaned datasets and generated outputs live on disk.
# TODO: revisit once storage strategy (local disk vs. object storage) is decided.
DATASETS_RAW_DIR=../datasets/raw
DATASETS_CLEANED_DIR=../datasets/cleaned
OUTPUTS_DIR=../outputs
